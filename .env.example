# logreducer local environment - copy to .env and fill in.
#
# .env is GITIGNORED and must never be committed (it can hold a real
# credential). Everything here is OPTIONAL: it is read only by the
# integration tests and by the logging runtime. The library itself needs none of it.
#
# ClickHouse and Kafka for the integration tests come from scalo's shared test
# services: one container each per run, or an always-present server named by the
# HYPERI_TEST_* settings below when it answers (never in CI or under the full
# tier). Without Docker the test skips locally and fails in CI. Each test makes
# its own database or topics and drops them afterwards.

# --- ClickHouse pet (integration tests) -------------------------------------
# HYPERI_TEST_CLICKHOUSE_HOST="localhost"
# HYPERI_TEST_CLICKHOUSE_HTTP_PORT="8123"
# HYPERI_TEST_CLICKHOUSE_USER="default"
# HYPERI_TEST_CLICKHOUSE_PASSWORD=""
# HYPERI_TEST_CLICKHOUSE_CLUSTER="default"

# --- Kafka pet (integration tests) ------------------------------------------
# HYPERI_TEST_KAFKA_BOOTSTRAP="localhost:9092"
# HYPERI_TEST_KAFKA_SECURITY_PROTOCOL="SASL_SSL"
# HYPERI_TEST_KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
# HYPERI_TEST_KAFKA_USER="user"
# HYPERI_TEST_KAFKA_PASSWORD=""
# HYPERI_TEST_KAFKA_CA_FILE="/path/to/ca.pem"
# HYPERI_TEST_KAFKA_TOPIC_PREFIX="test-"

# --- PostgreSQL and MySQL test containers (optional) ------------------------
# Keep the throwaway PostgreSQL and MySQL containers RUNNING after the run
# (default: stop + remove).
# LOGREDUCER_KEEP_CONTAINERS="1"

# --- Logging (runtime, optional) ---------------------------------------------
# Honoured by logreducer's logging when enabled (see README "Logging").
# LOG_LEVEL="INFO"       # TRACE|DEBUG|INFO|WARNING|ERROR|CRITICAL
# LOG_FORMAT="text"      # text (human) | json (one object per line)
# LOG_OUTPUT="stderr"    # stderr | stdout (console sink destination)
