# Environment Configuration Example
# Copy this file to .env and configure your settings
# All settings must be either ON or OFF unless otherwise specified

# ============================================
# BRANDING & ENTITY CONFIGURATION
# ============================================

# Company/Project entity name for branding in CI/CD and developer tools
# This will be used in all automation messages, tools, and workflows
# Default: HyperSec
CICD_ENTITY=HyperSec

# Optional: Override entity name for specific components
# CICD_ENTITY_PREFIX=HS  # Short prefix for constrained spaces
# CICD_ENTITY_FULL="HyperSec Security Solutions"  # Full company name

# ============================================
# PYTHON VERSION CONFIGURATION
# ============================================

# Minimum Python version template/baseline (organizational standard)
# This can be overridden but will only be increased, never decreased
# Default: 3.12 (project standard, see .python-version-config.yaml)
PYTHON_MIN_VERSION=3.12

# Enable automatic Python version detection using Vermin
# Default: ON
PYTHON_VERSION_DETECTION_ENABLED=ON

# Only allow version increases (never decrease minimum)
# Default: ON 
PYTHON_VERSION_INCREASE_ONLY=ON

# ============================================
# DEPLOYMENT SWITCHES
# ============================================

# Enable/disable PyPI deployment to public Python Package Index
# Default: ON (set to OFF to disable)
ENABLE_PYPI_DEPLOYMENT=ON

# Enable/disable GitHub Release creation
# Default: ON (set to OFF to disable)
ENABLE_GITHUB_RELEASE=ON

# Enable/disable deployment to private JFrog Artifactory
# Default: ON
ENABLE_ARTIFACTORY_DEPLOYMENT=ON

# Enable/disable semantic release automation
# Default: ON
ENABLE_SEMANTIC_RELEASE=ON

# ============================================
# REPOSITORY SETTINGS
# ============================================

# JFrog Artifactory URL for private PyPI repository
# Replace with your organization's Artifactory URL
ARTIFACTORY_URL=https://your-org.jfrog.io/artifactory/api/pypi/pypi-local/

# Artifactory repository name
ARTIFACTORY_REPOSITORY=pypi-local

# PyPI repository (use 'pypi' for production, 'testpypi' for testing)
PYPI_REPOSITORY=pypi

# ============================================
# RELEASE CONFIGURATION
# ============================================

# Automatically bump version based on commit messages
# Default: ON
AUTO_VERSION_BUMP=ON

# Create git tags for releases
# Default: ON
CREATE_GIT_TAG=ON

# Update CHANGELOG.md with release notes
# Default: ON
UPDATE_CHANGELOG=ON

# Update VERSION file with current version
# Default: ON
UPDATE_VERSION_FILE=ON

# ============================================
# BUILD SETTINGS
# ============================================

# Build Python wheel distribution
# Default: ON
BUILD_WHEEL=ON

# Build source distribution (sdist)
# Default: ON
BUILD_SDIST=ON

# Run full test suite before releasing
# Default: ON
RUN_TESTS_BEFORE_RELEASE=ON

# Run security checks before release
# Default: ON
RUN_SECURITY_CHECKS=ON

# ============================================
# NOTIFICATION SETTINGS
# ============================================

# Send Slack notifications for releases
# Default: OFF
SLACK_NOTIFICATIONS=OFF

# Slack webhook URL (required if SLACK_NOTIFICATIONS=ON)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Send email notifications for releases
# Default: OFF
EMAIL_NOTIFICATIONS=OFF

# Email recipients (comma-separated, required if EMAIL_NOTIFICATIONS=ON)
EMAIL_RECIPIENTS=devops@example.com,team@example.com

# ============================================
# CI/CD SETTINGS
# ============================================

# Use self-hosted runners instead of GitHub cloud runners
# Default: OFF (uses GitHub cloud runners for safety and simplicity)
# Set to ON only if you have configured secure self-hosted runners
USE_SELF_HOSTED_RUNNERS=OFF

# Run CI/CD on pull requests
# Default: ON
CI_ON_PULL_REQUEST=ON

# Run CI/CD on push to main/develop
# Default: ON
CI_ON_PUSH=ON

# Deploy from branch (main, develop, or release/*)
# Default: main
DEPLOY_BRANCH=main

# ============================================
# DEBUG SETTINGS
# ============================================

# Enable debug mode for verbose output
# Default: OFF
DEBUG_MODE=OFF

# Dry run mode - simulate release without making changes
# Default: OFF
DRY_RUN=OFF

# Verbose logging level (ERROR, WARNING, INFO, DEBUG)
# Default: INFO
LOG_LEVEL=INFO

# ============================================
# CREDENTIALS (DO NOT COMMIT!)
# ============================================
# These should be set as environment variables or GitHub secrets
# Never commit actual credentials to version control

# JFrog Artifactory credentials
# ARTIFACTORY_USERNAME=your-username
# ARTIFACTORY_PASSWORD=your-password-or-token

# PyPI credentials
# PYPI_USERNAME=__token__
# PYPI_PASSWORD=pypi-your-api-token

# GitHub token for releases
# GITHUB_TOKEN=ghp_your_github_token

# ============================================
# ADVANCED SETTINGS
# ============================================

# Maximum upload size in MB
MAX_UPLOAD_SIZE=100

# Upload timeout in seconds
UPLOAD_TIMEOUT=300

# Number of upload retries
UPLOAD_RETRIES=3

# Parallel upload threads
PARALLEL_UPLOADS=4

# Cache directory for builds
BUILD_CACHE_DIR=.build-cache

# Keep build artifacts after release
KEEP_BUILD_ARTIFACTS=OFF