# Line endings: normalise to LF everywhere (checkout as-is on all platforms).
* text=auto eol=lf

# Sample/corpora data ships as PLAIN git blobs - deliberately NOT LFS, so a
# public clone needs no git-lfs and burns no LFS bandwidth quota. The data is
# small (a few MB) and write-once.
data/samples/*.log text eol=lf linguist-generated
tests/testdata/*.log.gz binary
tests/testdata/manifest.json linguist-generated

# Binary types (no diff/eol mangling)
*.png binary
*.gz binary
*.zip binary

# Merge drivers: generated by the release tagger - keep ours on merge.
CHANGELOG.md merge=ours
VERSION merge=ours

# Language statistics
docs/* linguist-documentation
data/* linguist-documentation
