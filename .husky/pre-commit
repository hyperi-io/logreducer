#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Pre-commit hook for LogReducer
echo "🔍 Running pre-commit checks..."

# Run quick format check (don't modify, just check)
if command -v black > /dev/null; then
  echo "📝 Checking code formatting..."
  black --check src/ tests/ scripts/ --quiet 2>/dev/null || {
    echo "⚠️  Code formatting issues detected. Run 'black src/ tests/ scripts/' to fix"
  }
fi

echo "✅ Pre-commit checks complete"
