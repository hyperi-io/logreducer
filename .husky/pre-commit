#!/bin/sh

# Load environment variables
if [ -f .env ]; then
    export $(grep -E '^CICD_ENTITY=' .env | xargs)
fi
CICD_ENTITY=${CICD_ENTITY:-"HyperSec"}

# Pre-commit hook
echo "Running ${CICD_ENTITY} pre-commit checks..."

# Run quick format check (don't modify, just check)
if command -v black > /dev/null; then
  echo "Checking code formatting..."
  black --check src/ tests/ scripts/ --quiet 2>/dev/null || {
    echo "WARNING: Code formatting issues detected. Run 'black src/ tests/ scripts/' to fix"
  }
fi

echo "${CICD_ENTITY} pre-commit checks complete"
