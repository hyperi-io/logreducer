#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Pre-push hook for LogReducer
# Ensures comprehensive quality checks before pushing to remote

echo "🚀 Running pre-push checks..."

# Get the remote and branch being pushed to
remote="$1"
url="$2"

# Check if we're pushing to main or develop
protected_branches="main|develop"
current_branch=$(git rev-parse --abbrev-ref HEAD)

if echo "$current_branch" | grep -qE "^($protected_branches)$"; then
    echo "🛡️  Pushing to protected branch: $current_branch"
    echo "   Running comprehensive checks..."
    
    # 1. Ensure all tests pass
    echo "🧪 Running full test suite..."
    if command -v uv > /dev/null; then
        uv run pytest tests/ -v
        if [ $? -ne 0 ]; then
            echo "❌ Test suite failed"
            exit 1
        fi
    else
        echo "⚠️  uv not found, skipping tests"
    fi
    
    # 2. Run security scan
    echo "🛡️  Running security scan..."
    if [ -f "scripts/security_scan.py" ]; then
        python scripts/security_scan.py --report-only
        if [ $? -ne 0 ]; then
            echo "⚠️  Security scan completed with warnings"
        fi
    fi
    
    # 3. Check documentation builds
    echo "📚 Checking documentation builds..."
    if command -v uv > /dev/null; then
        uv run sphinx-build -W -b html docs/ docs/_build/html > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            echo "❌ Documentation build failed"
            exit 1
        fi
    fi
    
    # 4. Verify package can be built
    echo "📦 Verifying package build..."
    if command -v python > /dev/null; then
        python -m build --wheel --outdir .tmp/ > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            echo "❌ Package build failed"
            exit 1
        fi
    fi
    
    # 5. Check for version consistency
    echo "🔢 Checking version consistency..."
    if [ -f "VERSION" ] && [ -f "pyproject.toml" ]; then
        version_file=$(cat VERSION)
        toml_version=$(grep 'version = "' pyproject.toml | sed 's/version = "\([^"]*\)"/\1/')
        if [ "$version_file" != "$toml_version" ]; then
            echo "❌ Version mismatch: VERSION file ($version_file) != pyproject.toml ($toml_version)"
            exit 1
        fi
    fi
    
    echo "✅ All pre-push checks passed for protected branch"
else
    echo "📝 Pushing to feature branch: $current_branch"
    
    # Lighter checks for feature branches
    echo "🧪 Running unit tests..."
    if command -v uv > /dev/null; then
        uv run pytest tests/unit/ -x --tb=short -q
        if [ $? -ne 0 ]; then
            echo "❌ Unit tests failed"
            exit 1
        fi
    fi
    
    echo "✅ Feature branch checks passed"
fi

echo "🎉 Ready to push to $remote"