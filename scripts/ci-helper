#!/usr/bin/env python3
"""
CI/CD Helper Script - Generic for any Python project
Contains utilities used by GitHub Actions and other CI/CD systems
"""

import argparse
import sys
import re
from pathlib import Path

# Import common utilities
sys.path.insert(0, str(Path(__file__).parent))

# Try importing with fallback for when venv isn't active
try:
    from common import (
        PROJECT_ROOT, SCRIPT_DIR,
        get_project_version, get_package_name,
        load_yaml_config
    )
except ImportError:
    # Fallback when dependencies aren't available
    PROJECT_ROOT = Path(__file__).parent.parent
    SCRIPT_DIR = Path(__file__).parent
    
    def get_project_version():
        version_file = PROJECT_ROOT / "VERSION"
        if version_file.exists():
            return version_file.read_text().strip()
        return "unknown"
    
    def get_package_name():
        return "logreducer"
    
    def load_yaml_config(path):
        try:
            import yaml
            with open(path) as f:
                return yaml.safe_load(f)
        except:
            return {}

# Configuration file
CONFIG_FILE = SCRIPT_DIR / "ci-helper.yaml"
CONFIG = load_yaml_config(CONFIG_FILE)

def update_version_file(version):
    """Update VERSION file only (for CI/CD after semantic-release)"""
    version_file = PROJECT_ROOT / "VERSION"
    version_file.write_text(f"{version}\n")
    print(f"Updated VERSION file to: {version}")
    return True


def verify_versions():
    """Verify all version files are in sync"""
    errors = []
    
    # Get versions from all sources
    version_file = PROJECT_ROOT / "VERSION"
    version_from_file = version_file.read_text().strip() if version_file.exists() else None
    
    pyproject_version = get_project_version()
    
    init_file = PROJECT_ROOT / "src" / "logreducer" / "__init__.py"
    init_version = None
    if init_file.exists():
        content = init_file.read_text()
        match = re.search(r'__version__\s*=\s*["\']([^"\']+)["\']', content)
        if match:
            init_version = match.group(1)
    
    # Check consistency
    versions = {
        "VERSION file": version_from_file,
        "pyproject.toml": pyproject_version,
        "__init__.py": init_version
    }
    
    print("Version check:")
    for source, version in versions.items():
        print(f"  {source}: {version or 'NOT FOUND'}")
    
    # All should match
    unique_versions = set(v for v in versions.values() if v)
    if len(unique_versions) > 1:
        print(f"❌ Version mismatch detected!")
        return False
    elif len(unique_versions) == 0:
        print(f"❌ No versions found!")
        return False
    else:
        print(f"✅ All versions match: {unique_versions.pop()}")
        return True

def prepare_release():
    """Prepare for release by ensuring everything is ready"""
    print("Preparing release...")
    
    # Verify versions are in sync
    if not verify_versions():
        print("ERROR: Version files not in sync")
        return False
    
    # Get current version
    version = get_project_version()
    if not version:
        print("ERROR: Could not determine version")
        return False
    
    print(f"Ready to release version: {version}")
    return True

def test_editable_install():
    """Test PEP 660 editable install compatibility (for CI/CD)"""
    import subprocess
    import importlib
    
    print("Testing PEP 660 editable install compatibility...")
    
    try:
        # Test import
        print("1. Testing import...")
        # Dynamic import based on project detection
        package_name = None
        
        # Try to get package name from pyproject.toml
        package_name = get_package_name()
        
        if not package_name:
            print("ERROR: Could not determine package name")
            return False
        
        # Import the package
        module = importlib.import_module(package_name)
        print(f"   ✅ Package '{package_name}' imported successfully")
        
        # Check version if available
        if hasattr(module, '__version__'):
            print(f"   Version: {module.__version__}")
        
        # Test CLI if exists
        print("2. Testing CLI command...")
        cli_result = subprocess.run(
            [package_name, "--version"],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if cli_result.returncode == 0:
            print(f"   ✅ CLI command works: {cli_result.stdout.strip()}")
        else:
            print(f"   ⏭️  No CLI command or failed")
        
        # Test that source files are properly linked
        print("3. Testing editable install linkage...")
        module_file = Path(module.__file__)
        if "site-packages" not in str(module_file):
            print(f"   ✅ Editable install confirmed (source at: {module_file.parent})")
        else:
            print(f"   ⚠️  May not be editable install (installed at: {module_file.parent})")
            return False
        
        print("\n✅ Editable install test PASSED")
        return True
        
    except ImportError as e:
        print(f"❌ Import failed: {e}")
        return False
    except subprocess.TimeoutExpired:
        print("❌ CLI test timed out")
        return False
    except Exception as e:
        print(f"❌ Test failed: {e}")
        return False

def main():
    parser = argparse.ArgumentParser(description="CI/CD Helper for LogReducer")
    
    subparsers = parser.add_subparsers(dest="command", help="Commands")
    
    # update-version command
    update_parser = subparsers.add_parser("update-version", 
                                          help="Update VERSION file only (for CI/CD)")
    update_parser.add_argument("version", help="Version to set")
    
    # verify-versions command
    subparsers.add_parser("verify-versions", 
                         help="Verify all version files match")
    
    # prepare-release command
    subparsers.add_parser("prepare-release",
                         help="Prepare for release")
    
    # test-editable command
    subparsers.add_parser("test-editable",
                         help="Test editable install (PEP 660)")
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return 1
    
    if args.command == "update-version":
        if update_version_file(args.version):
            return 0
        return 1
    elif args.command == "verify-versions":
        if verify_versions():
            return 0
        return 1
    elif args.command == "prepare-release":
        if prepare_release():
            return 0
        return 1
    elif args.command == "test-editable":
        if test_editable_install():
            return 0
        return 1
    
    return 0

if __name__ == "__main__":
    sys.exit(main())