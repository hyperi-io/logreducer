#!/usr/bin/env python3
"""
Bootstrap script to create CI virtual environment
This runs with system Python and sets up .venv-ci for CI operations
"""

import os
import sys
import subprocess
from pathlib import Path

# Colors for output
RED = '\033[91m'
GREEN = '\033[92m'
YELLOW = '\033[93m'
BLUE = '\033[94m'
NC = '\033[0m'  # No Color

def print_header(msg):
    print(f"\n{BLUE}{'='*60}{NC}")
    print(f"{BLUE}{msg}{NC}")
    print(f"{BLUE}{'='*60}{NC}")

def print_success(msg):
    print(f"{GREEN}[OK]{NC} {msg}")

def print_error(msg):
    print(f"{RED}[ERROR]{NC} {msg}")

def print_info(msg):
    print(f"{YELLOW}[INFO]{NC} {msg}")

def print_warning(msg):
    print(f"{YELLOW}[WARN]{NC} {msg}")

def run_command(cmd, description, check=True):
    """Run a command and return success status"""
    print_info(description)
    try:
        result = subprocess.run(
            cmd,
            shell=isinstance(cmd, str),
            capture_output=True,
            text=True,
            check=check
        )
        if result.returncode == 0:
            print_success(f"{description} - completed")
            return True
        else:
            print_error(f"{description} - failed")
            if result.stderr:
                print(f"  Error: {result.stderr}")
            return False
    except subprocess.CalledProcessError as e:
        print_error(f"{description} - failed")
        if e.stderr:
            print(f"  Error: {e.stderr}")
        return False
    except FileNotFoundError:
        print_error(f"Command not found: {cmd[0] if isinstance(cmd, list) else cmd.split()[0]}")
        return False

def check_python():
    """Check Python version"""
    version = sys.version_info
    if version.major < 3 or (version.major == 3 and version.minor < 11):
        print_error(f"Python 3.11+ required, found {version.major}.{version.minor}")
        return False
    print_success(f"Python {version.major}.{version.minor}.{version.micro} detected")
    return True

def check_uv():
    """Check if uv is installed"""
    result = subprocess.run(["which", "uv"], capture_output=True)
    if result.returncode != 0:
        print_error("uv not found. Please install it:")
        print("  curl -LsSf https://astral.sh/uv/install.sh | sh")
        return False
    print_success("uv is installed")
    return True

def main():
    """Main bootstrap process"""
    print_header("CI Environment Bootstrap")
    
    # Get project root
    project_root = Path(__file__).parent.parent
    os.chdir(project_root)
    print_info(f"Project root: {project_root}")
    
    # Check prerequisites
    if not check_python():
        return 1
    
    if not check_uv():
        return 1
    
    # Check if .venv-ci already exists
    venv_path = project_root / ".venv-ci"
    if venv_path.exists():
        print_info(".venv-ci already exists")
        response = input(f"{YELLOW}Remove and recreate? (y/N): {NC}").lower()
        if response == 'y':
            print_info("Removing existing .venv-ci...")
            subprocess.run(["rm", "-rf", str(venv_path)], check=False)
        else:
            print_info("Keeping existing .venv-ci")
            
    # Create CI virtual environment
    if not venv_path.exists():
        if not run_command(
            ["uv", "venv", ".venv-ci", "--python", "3.12"],
            "Creating .venv-ci with Python 3.12"
        ):
            return 1
    
    # Install CI dependencies
    print_header("Installing CI Dependencies")
    
    venv_pip = venv_path / "bin" / "pip"
    venv_python = venv_path / "bin" / "python"
    
    # Core CI dependencies
    ci_deps = [
        # Build and deployment
        "build",           # Package building
        "twine",           # Package upload
        "wheel",           # Wheel package format
        "setuptools",      # Package setup
        
        # Testing
        "pytest>=7.0.0",          # Testing framework
        "pytest-cov>=4.0.0",      # Coverage plugin
        "pytest-timeout>=2.1.0",  # Test timeouts
        "pytest-xdist>=3.0.0",    # Parallel test execution
        
        # Code quality
        "black>=23.0.0",          # Code formatter
        "isort>=5.12.0",          # Import sorting
        "flake8>=6.0.0",          # Linting
        "mypy>=1.0.0",            # Type checking
        
        # Type stubs
        "types-psutil",           # Type stubs for psutil
        "types-tqdm",             # Type stubs for tqdm
        "scipy-stubs",            # Type stubs for scipy
        "types-pyyaml",           # Type stubs for yaml
        
        # Security
        "pip-audit>=2.6.0",       # Dependency vulnerability scanning
        "bandit[toml]>=1.7.5",    # Security linting
        
        # CI utilities
        "pyyaml>=6.0",            # YAML parsing
        "loguru>=0.7.0",          # Logging for CI script
        "click>=8.0.0",           # CLI framework
        "toml>=0.10.2",           # TOML config parsing
    ]
    
    print_info(f"Installing {len(ci_deps)} CI dependencies...")
    if not run_command(
        ["uv", "pip", "install", "--python", str(venv_python)] + ci_deps,
        "Installing CI dependencies"
    ):
        return 1
    
    # Install ALL project dependencies (core + dev + enhanced)
    print_header("Installing Project Dependencies")
    
    # First install core project dependencies
    if not run_command(
        ["uv", "pip", "install", "--python", str(venv_python), "-e", "."],
        "Installing project core dependencies"
    ):
        print_error("Failed to install core dependencies")
        return 1
    
    # Then install development dependencies
    if not run_command(
        ["uv", "pip", "install", "--python", str(venv_python), "-e", ".[dev]"],
        "Installing development dependencies"
    ):
        print_warning("Some dev dependencies failed - continuing")
    
    # Finally install enhanced dependencies (optional)
    if not run_command(
        ["uv", "pip", "install", "--python", str(venv_python), "-e", ".[enhanced]"],
        "Installing enhanced dependencies"
    ):
        print_info("Enhanced dependencies are optional - continuing")
    
    # Create CI configuration file
    print_header("Creating CI Configuration")
    
    ci_config = project_root / ".ci-config.yaml"
    config_content = """# CI Configuration
# This file is used by scripts/ci

python:
  version: "3.12"
  venv: ".venv-ci"

ci:
  stages:
    - version_check
    - lint
    - format_check
    - type_check
    - test
    - security
    - build
  
  skip_slow_tests: false
  parallel_jobs: 4
  
  timeouts:
    test: 300
    security: 600
    build: 180
    default: 120

security:
  min_level: NONE  # NONE, LOW, MEDIUM, HIGH, CRITICAL
  tools:
    - pip-audit
    - bandit
  
build:
  clean_first: true
  formats:
    - wheel
    - sdist

jfrog:
  repository_url: "https://hypersec.jfrog.io/artifactory/api/pypi/hypersec-pypi-local/"
  # Credentials should be in environment or GitHub Secrets
"""
    
    with open(ci_config, 'w') as f:
        f.write(config_content)
    print_success("Created .ci-config.yaml")
    
    # Update .gitignore
    gitignore_path = project_root / ".gitignore"
    if gitignore_path.exists():
        content = gitignore_path.read_text()
        if ".venv-ci" not in content:
            print_info("Adding .venv-ci to .gitignore")
            with open(gitignore_path, 'a') as f:
                f.write("\n# CI virtual environment\n.venv-ci/\n")
    
    # Verify installation
    print_header("Verifying Installation")
    
    # Check critical packages
    critical_packages = [
        ("pytest", "Testing framework"),
        ("black", "Code formatter"),
        ("flake8", "Linter"),
        ("mypy", "Type checker"),
        ("build", "Package builder"),
        ("twine", "Package uploader"),
    ]
    
    all_good = True
    for package, description in critical_packages:
        result = subprocess.run(
            [str(venv_python), "-m", "pip", "show", package],
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            print_success(f"{package}: {description}")
        else:
            print_error(f"{package}: {description} - NOT INSTALLED")
            all_good = False
    
    # Check if project is importable
    result = subprocess.run(
        [str(venv_python), "-c", "import logreducer; print(logreducer.__version__)"],
        capture_output=True,
        text=True
    )
    if result.returncode == 0:
        version = result.stdout.strip()
        print_success(f"LogReducer importable: version {version}")
    else:
        print_warning("LogReducer not fully importable (may be normal for CI)")
    
    # Summary
    print_header("Bootstrap Complete!")
    if all_good:
        print_success("CI environment created successfully")
    else:
        print_warning("CI environment created with some warnings")
    
    print()
    print("Next steps:")
    print(f"  1. Run CI: {GREEN}scripts/ci{NC}")
    print(f"  2. Run specific stage: {GREEN}scripts/ci --stage test{NC}")
    print(f"  3. Skip slow tests: {GREEN}scripts/ci --skip-slow{NC}")
    print()
    print(f"CI Python: {GREEN}{venv_python}{NC}")
    print(f"CI Config: {GREEN}{ci_config}{NC}")
    
    # Show environment size
    try:
        size_result = subprocess.run(
            ["du", "-sh", str(venv_path)],
            capture_output=True,
            text=True
        )
        if size_result.returncode == 0:
            size = size_result.stdout.split()[0]
            print(f"Environment size: {GREEN}{size}{NC}")
    except:
        pass
    
    return 0

if __name__ == "__main__":
    sys.exit(main())
