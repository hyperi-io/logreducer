#!/usr/bin/env python3
"""
LogReducer Environment Setup
One-time setup for development environment
"""

import sys
import subprocess
from pathlib import Path

PROJECT_ROOT = Path(__file__).parent.parent

def run_cmd(cmd, check=True):
    """Run command and print it"""
    print(f"→ {' '.join(cmd)}")
    return subprocess.run(cmd, check=check)

def load_tool_requirements():
    """Load tool requirements from unified pdev.yaml file with fallback"""
    pdev_config_file = Path(__file__).parent / "pdev.yaml"
    
    # Try to load from unified pdev.yaml file first
    if pdev_config_file.exists():
        try:
            import yaml
            with open(pdev_config_file) as f:
                pdev_config = yaml.safe_load(f)
                # Extract tool requirements from the unified config
                tools = pdev_config.get('tools', {})
                return {
                    'required_tools': tools.get('required', {}),
                    'optional_tools': tools.get('optional', {}),
                    'environment_checks': tools.get('environment', {}),
                    'platform_tools': tools.get('platform', {})
                }
        except ImportError:
            # PyYAML not available, use fallback
            pass
        except Exception as e:
            print(f"Warning: Could not load {pdev_config_file}: {e}")
    
    # Fallback to legacy tool_requirements.yaml if it exists
    legacy_file = Path(__file__).parent / "tool_requirements.yaml"
    if legacy_file.exists():
        try:
            import yaml
            with open(legacy_file) as f:
                return yaml.safe_load(f)
        except:
            pass
    
    # Final fallback to minimal hardcoded requirements
    print("Using hardcoded fallback requirements (install PyYAML for full requirements)")
    return {
        'required_tools': {
            'python3': {
                'check': ['python3', '--version'],
                'description': 'Python 3.12+ interpreter',
                'install_hint': 'Install Python 3.12+ from your system package manager'
            },
            'uv': {
                'check': ['uv', '--version'],
                'description': 'UV package and virtual environment manager',
                'install_hint': 'curl -LsSf https://astral.sh/uv/install.sh | sh'
            }
        },
        'optional_tools': {
            'git': {
                'check': ['git', '--version'],
                'description': 'Git version control system',
                'install_hint': 'Install git from your system package manager'
            },
            'curl': {
                'check': ['curl', '--version'],
                'description': 'HTTP client for downloads',
                'install_hint': 'Install curl from your system package manager'
            }
        },
        'environment_checks': {
            'src_exists': {
                'check_path': 'src/logreducer',
                'description': 'LogReducer source code directory'
            },
            'tests_exists': {
                'check_path': 'tests',
                'description': 'Test suite directory'
            }
        }
    }

def check_tool_requirements():
    """Check tool requirements"""
    requirements = load_tool_requirements()
    
    print("Checking tool requirements...")
    
    # Check required tools
    missing_required = []
    for tool_name, tool_info in requirements.get('required_tools', {}).items():
        try:
            subprocess.run(tool_info['check'], check=True, capture_output=True)
            print(f"[OK] {tool_name}: {tool_info['description']}")
        except (subprocess.CalledProcessError, FileNotFoundError):
            print(f"[MISSING] {tool_name}: {tool_info['description']} - REQUIRED")
            print(f"   Install: {tool_info['install_hint']}")
            missing_required.append(tool_name)
    
    # Check optional tools  
    for tool_name, tool_info in requirements.get('optional_tools', {}).items():
        try:
            subprocess.run(tool_info['check'], check=True, capture_output=True)
            print(f"[OK] {tool_name}: {tool_info['description']}")
        except (subprocess.CalledProcessError, FileNotFoundError):
            print(f"[OPTIONAL] {tool_name}: {tool_info['description']} - not installed")
            print(f"   Install: {tool_info['install_hint']}")
    
    # Check environment
    for check_name, check_info in requirements.get('environment_checks', {}).items():
        check_path = Path(check_info['check_path'])
        if check_path.exists():
            print(f"[OK] {check_name}: {check_info['description']}")
        else:
            print(f"[INFO] {check_name}: {check_info['description']} - will be created")
    
    if missing_required:
        print(f"\n[ERROR] Missing required tools: {', '.join(missing_required)}")
        return False
    
    print("[OK] All required tools available")
    return True

def main():
    print("Setting up LogReducer development environment")
    print()
    
    # Check tool requirements
    if not check_tool_requirements():
        print("\nPlease install missing required tools and run setup again.")
        sys.exit(1)
    print()
    
    # Create virtual environment
    venv_path = PROJECT_ROOT / ".venv"
    if venv_path.exists():
        print(f"[OK] Virtual environment already exists at {venv_path}")
    else:
        print("Creating virtual environment...")
        run_cmd(["uv", "venv", ".venv"])
    
    # Install dependencies
    print("Installing dependencies...")
    run_cmd(["uv", "pip", "install", "-e", ".[dev,enhanced]"])
    
    # Setup pre-commit hooks (optional)
    print("Setting up pre-commit hooks...")
    venv_python = venv_path / "bin" / "python"
    try:
        run_cmd([str(venv_python), "-m", "pre_commit", "install"])
    except subprocess.CalledProcessError:
        print("[OPTIONAL] Pre-commit hooks not available (optional dependency)")
        print("   To install: uv pip install pre-commit")
    
    # Initialize semantic-release if needed
    print()
    print("Checking semantic-release setup...")
    
    # Check if semantic-release is configured in pyproject.toml
    pyproject_file = PROJECT_ROOT / "pyproject.toml"
    has_semantic_release = False
    if pyproject_file.exists():
        content = pyproject_file.read_text()
        has_semantic_release = "[tool.semantic_release]" in content or "[tool.semantic-release]" in content
    
    if has_semantic_release:
        # Run the initialization helper
        init_script = PROJECT_ROOT / "scripts" / "init_semantic_release.py"
        if init_script.exists():
            try:
                result = subprocess.run(
                    [sys.executable, str(init_script)],
                    capture_output=True,
                    text=True,
                    input="y\n"  # Auto-confirm for smooth setup
                )
                if result.returncode == 0:
                    # Parse output for success message
                    if "Successfully created tag" in result.stdout:
                        print("[OK] Semantic-release initialized with version tag")
                    elif "tags already exist" in result.stdout:
                        print("[OK] Semantic-release ready (tags exist)")
                    else:
                        print("[OK] Semantic-release checked")
                else:
                    print("[INFO] Semantic-release initialization skipped")
                    print("   Run 'python scripts/init_semantic_release.py' to set up later")
            except Exception:
                print("[INFO] Could not auto-initialize semantic-release")
                print("   Run 'python scripts/init_semantic_release.py' manually if needed")
        else:
            # Fallback to simple check
            try:
                result = subprocess.run(["git", "tag", "-l"], capture_output=True, text=True, check=True)
                if result.stdout.strip():
                    tags = result.stdout.strip().split('\n')
                    print(f"[OK] Git tags found for semantic-release. Latest: {tags[-1]}")
                else:
                    print("[INFO] No git tags found")
                    print("   Run 'python scripts/init_semantic_release.py' to initialize semantic-release")
            except Exception:
                pass
    else:
        print("[INFO] Semantic-release not configured in this project")
    
    print()
    print("[OK] Development environment ready!")
    print()
    print("Next steps:")
    print("  scripts/pdev test            # Run tests (auto-activates venv)")
    print("  scripts/pdev format          # Format code") 
    print("  scripts/pdev all             # Run all checks")
    print()
    print("Note: The pdev script automatically activates .venv and sets PATH")

if __name__ == "__main__":
    main()
